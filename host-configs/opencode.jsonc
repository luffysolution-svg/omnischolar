{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "omnischolar": {
      "type": "local",
      "command": ["uvx", "--refresh-package", "luffysolution-omnischolar", "--from", "luffysolution-omnischolar@latest", "omnischolar", "mcp"],
      "enabled": true,
      "timeout": 10000
    }
  }
}
